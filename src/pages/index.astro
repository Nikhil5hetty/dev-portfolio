---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntryCard from "@/components/EntryCard.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import { SITE } from "@/site";
import { isPublished, sortByDateDesc } from "@/lib/content";
import { withBase } from "@/lib/withBase";
import { PROFILE } from "@/data/profile";

const [posts, projects] = await Promise.all([
  getCollection("posts"),
  getCollection("projects"),
]);

const publishedPosts = sortByDateDesc(posts.filter(isPublished));
const publishedProjects = sortByDateDesc(projects.filter(isPublished));
const featuredProjects = publishedProjects.filter(({ data }) => data.featured);

const primaryButtonClass =
  "inline-flex items-center gap-2 rounded-full bg-[var(--accent-solid)] px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90";
const secondaryButtonClass =
  "inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]/40 hover:bg-[var(--surface-strong)]";
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="panel home-hero rounded-[2rem] p-7 sm:p-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-start">
      <div class="space-y-5">
        <p class="inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--surface-strong)] px-4 py-2 text-sm text-[var(--text)]">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          {PROFILE.availability}
        </p>
        <div>
          <h1 class="text-4xl font-semibold tracking-[-0.03em] text-[var(--text)] sm:text-5xl">
            {PROFILE.name}
          </h1>
          <p class="mt-2 text-lg font-medium text-[var(--accent)] sm:text-xl">
            {PROFILE.role} · {PROFILE.stackLine}
          </p>
        </div>
        <p class="max-w-2xl text-2xl font-semibold leading-snug tracking-[-0.02em] text-[var(--text)] sm:text-[1.75rem]">
          {PROFILE.headline}
        </p>
        <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg">
          {PROFILE.summary}
        </p>
        <p class="text-sm text-[var(--muted)]">
          {PROFILE.location} · {PROFILE.currentStudy}
        </p>
      </div>

      <img
        src={withBase("/images/profile-photo.jpeg")}
        alt="Portrait of Nikhil Shetty"
        class="hidden aspect-square w-48 rounded-[1.75rem] border border-[var(--line)] object-cover object-[50%_18%] shadow-[var(--shadow)] lg:block"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase(PROFILE.resumePath)} download class={primaryButtonClass}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3v10m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Download resume
      </a>
      <a href={`mailto:${PROFILE.email}`} class={secondaryButtonClass}>
        {PROFILE.email}
      </a>
      <a href={SITE.linkedin} target="_blank" rel="noreferrer" class={secondaryButtonClass}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4.98 3.5C4.98 4.88 3.9 6 2.5 6S0 4.88 0 3.5 1.1 1 2.5 1 4.98 2.12 4.98 3.5ZM.19 8.98H4.81V23H.19V8.98ZM8.25 8.98h4.44v1.92h.06c.62-1.17 2.13-2.4 4.38-2.4 4.69 0 5.55 3.09 5.55 7.11V23h-4.63v-6.07c0-1.45-.03-3.31-2.02-3.31-2.03 0-2.34 1.58-2.34 3.2V23H8.25V8.98Z" fill="currentColor"/>
        </svg>
        LinkedIn
      </a>
      <a href={SITE.github} target="_blank" rel="noreferrer" class={secondaryButtonClass}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 4.41 2.87 8.16 6.84 9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.61-3.37-1.34-3.37-1.34-.46-1.18-1.12-1.49-1.12-1.49-.92-.63.07-.62.07-.62 1.02.07 1.56 1.05 1.56 1.05.9 1.55 2.35 1.1 2.93.84.09-.66.35-1.1.63-1.35-2.22-.25-4.56-1.11-4.56-4.93 0-1.09.39-1.98 1.04-2.68-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 2.5-.34c.85 0 1.71.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.56 1.42.21 2.47.11 2.73.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.68-4.57 4.92.36.31.69.93.69 1.88 0 1.36-.01 2.45-.01 2.78 0 .26.18.57.69.47A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10Z" fill="currentColor"/>
        </svg>
        GitHub
      </a>
    </div>

    <dl class="mt-10 grid gap-px overflow-hidden rounded-[1.25rem] border border-[var(--line)] bg-[var(--line)] sm:grid-cols-2 lg:grid-cols-4">
      {PROFILE.impactCards.map((card) => (
        <div class="bg-[var(--surface-strong)] p-5">
          <dt class="sr-only">{card.label}</dt>
          <dd class="text-3xl font-semibold tracking-[-0.03em] text-[var(--accent)]">{card.value}</dd>
          <dd class="mt-1 text-sm leading-5 text-[var(--muted)]">{card.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-16 space-y-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="home-kicker text-sm text-[var(--accent)]">Experience</p>
        <h2 class="home-title mt-2 text-3xl font-semibold tracking-[-0.03em] text-[var(--text)] sm:text-4xl">
          Where I've shipped production data systems
        </h2>
      </div>
      <a class="shrink-0 text-sm text-[var(--accent)] hover:text-[var(--accent-strong)]" href={withBase("/about/")}>
        Full history
      </a>
    </div>
    <div class="panel rounded-[2rem] p-6 sm:p-8">
      <ExperienceList compact />
    </div>
  </section>

  <section class="mt-16 space-y-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="home-kicker text-sm text-[var(--accent)]">Projects</p>
        <h2 class="home-title mt-2 text-3xl font-semibold tracking-[-0.03em] text-[var(--text)] sm:text-4xl">
          Spark and lakehouse case studies
        </h2>
      </div>
      <a class="shrink-0 text-sm text-[var(--accent)] hover:text-[var(--accent-strong)]" href={withBase("/projects/")}>
        View all
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {featuredProjects.slice(0, 3).map((project) => (
        <EntryCard
          href={`/projects/${project.slug}/`}
          title={project.data.title}
          description={project.data.description}
          meta={project.data.category}
          tags={project.data.stack.slice(0, 4)}
        />
      ))}
    </div>
  </section>

  <section class="mt-16 space-y-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="home-kicker text-sm text-[var(--accent)]">Writing</p>
        <h2 class="home-title mt-2 text-3xl font-semibold tracking-[-0.03em] text-[var(--text)] sm:text-4xl">
          Practical notes on Spark and data delivery
        </h2>
      </div>
      <a class="shrink-0 text-sm text-[var(--accent)] hover:text-[var(--accent-strong)]" href={withBase("/blog/")}>
        View all
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {publishedPosts.slice(0, 2).map((post) => (
        <EntryCard
          href={`/blog/${post.slug}/`}
          title={post.data.title}
          description={post.data.description}
          meta={post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
          tags={post.data.tags.slice(0, 4)}
        />
      ))}
    </div>
  </section>
</BaseLayout>
