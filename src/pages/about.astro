---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import { PROFILE } from "@/data/profile";
import { SITE } from "@/site";
import { withBase } from "@/lib/withBase";
---

<BaseLayout
  title={`Experience | ${SITE.author}`}
  description="Work history, skills, education and resume download for Nikhil Shetty, Principal Data Engineer."
>
  <section class="panel rounded-[2rem] p-7 sm:p-10">
    <p class="home-kicker text-sm text-[var(--accent)]">About</p>
    <h1 class="home-title mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.03em] text-[var(--text)] sm:text-5xl">
      {PROFILE.headline}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">{PROFILE.summary}</p>
    <p class="mt-4 max-w-3xl text-base leading-7 text-[var(--muted)]">
      I'm in the final semester of an MSc at the University of Bern, where my thesis applies machine
      learning to merge conflict resolution. {PROFILE.availability}.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={withBase(PROFILE.resumePath)}
        download
        class="inline-flex rounded-full bg-[var(--accent-solid)] px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90"
      >
        Download resume
      </a>
      <a
        href={`mailto:${PROFILE.email}`}
        class="inline-flex rounded-full border border-[var(--line)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]/40"
      >
        {PROFILE.email}
      </a>
    </div>
  </section>

  <section class="mt-16">
    <p class="home-kicker text-sm text-[var(--accent)]">Experience</p>
    <h2 class="home-title mt-2 text-3xl font-semibold tracking-[-0.03em] text-[var(--text)] sm:text-4xl">
      Professional experience
    </h2>
    <div class="panel mt-6 rounded-[2rem] p-6 sm:p-8">
      <ExperienceList />
    </div>
  </section>

  <section class="mt-16 grid gap-5 lg:grid-cols-3">
    <div class="panel rounded-[2rem] p-6">
      <p class="home-kicker text-xs text-[var(--accent)]">Core stack</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {PROFILE.coreStack.map((skill) => (
          <li class="rounded-full border border-[var(--line)] bg-[var(--surface-strong)] px-3 py-1 text-sm text-[var(--text)]">
            {skill}
          </li>
        ))}
      </ul>
    </div>

    <div class="panel rounded-[2rem] p-6">
      <p class="home-kicker text-xs text-[var(--accent)]">Education</p>
      <ul class="mt-4 space-y-4">
        {PROFILE.education.map((item) => (
          <li>
            <p class="font-semibold text-[var(--text)]">{item.school}</p>
            <p class="text-sm text-[var(--muted)]">{item.credential} · {item.period}</p>
            <p class="text-sm text-[var(--muted)]">{item.note}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="panel rounded-[2rem] p-6">
      <p class="home-kicker text-xs text-[var(--accent)]">Recognition</p>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--text)] marker:text-[var(--accent)]">
        {PROFILE.awards.map((award) => <li>{award}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
