---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntryCard from "@/components/EntryCard.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { SITE } from "@/site";
import { isPublished, sortByDateDesc } from "@/lib/content";
import { withBase } from "@/lib/withBase";
import { PROFILE } from "@/data/profile";

const [posts, projects] = await Promise.all([
  getCollection("posts"),
  getCollection("projects"),
]);

const publishedPosts = sortByDateDesc(posts.filter(isPublished));
const publishedProjects = sortByDateDesc(projects.filter(isPublished));
const featuredProjects = publishedProjects.filter(({ data }) => data.featured);

const primaryButtonClass =
  "inline-flex items-center gap-2 rounded-full bg-[var(--accent-solid)] px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90";
const secondaryButtonClass =
  "inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]/40 hover:bg-[var(--surface-strong)]";
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="pt-6 sm:pt-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="space-y-6">
        <p class="kicker">— {PROFILE.location} · {PROFILE.stackLine} —</p>
        <h1 class="display text-6xl font-semibold leading-[0.95] text-[var(--text)] sm:text-8xl">
          Nikhil<br /><span class="name-gradient">Shetty</span>
        </h1>
        <p class="text-xl text-[var(--text)] sm:text-2xl" aria-label={PROFILE.role}>
          <span data-typed data-roles={JSON.stringify(PROFILE.rotatingRoles)}>{PROFILE.role}</span><span class="typed-caret" aria-hidden="true"></span>
        </p>
        <p class="inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--surface)] px-4 py-2 text-sm text-[var(--text)]">
          <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          {PROFILE.availability}
        </p>
        <p class="display max-w-2xl text-2xl leading-snug text-[var(--text)] sm:text-3xl">
          {PROFILE.headline}
        </p>
        <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg">
          {PROFILE.summary}
        </p>
      </div>

      <img
        src={withBase("/images/profile-photo.jpeg")}
        alt="Portrait of Nikhil Shetty"
        class="hidden aspect-square w-64 rounded-full border border-[var(--line)] object-cover object-[50%_18%] shadow-[0_0_0_8px_var(--surface),var(--shadow)] lg:block"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase(PROFILE.resumePath)} download class={primaryButtonClass}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3v10m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Download resume
      </a>
      <a href={`mailto:${PROFILE.email}`} class={secondaryButtonClass}>
        {PROFILE.email}
      </a>
      <a href={SITE.linkedin} target="_blank" rel="noreferrer" class={secondaryButtonClass}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4.98 3.5C4.98 4.88 3.9 6 2.5 6S0 4.88 0 3.5 1.1 1 2.5 1 4.98 2.12 4.98 3.5ZM.19 8.98H4.81V23H.19V8.98ZM8.25 8.98h4.44v1.92h.06c.62-1.17 2.13-2.4 4.38-2.4 4.69 0 5.55 3.09 5.55 7.11V23h-4.63v-6.07c0-1.45-.03-3.31-2.02-3.31-2.03 0-2.34 1.58-2.34 3.2V23H8.25V8.98Z" fill="currentColor"/>
        </svg>
        LinkedIn
      </a>
      <a href={SITE.github} target="_blank" rel="noreferrer" class={secondaryButtonClass}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 4.41 2.87 8.16 6.84 9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.61-3.37-1.34-3.37-1.34-.46-1.18-1.12-1.49-1.12-1.49-.92-.63.07-.62.07-.62 1.02.07 1.56 1.05 1.56 1.05.9 1.55 2.35 1.1 2.93.84.09-.66.35-1.1.63-1.35-2.22-.25-4.56-1.11-4.56-4.93 0-1.09.39-1.98 1.04-2.68-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 2.5-.34c.85 0 1.71.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.56 1.42.21 2.47.11 2.73.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.68-4.57 4.92.36.31.69.93.69 1.88 0 1.36-.01 2.45-.01 2.78 0 .26.18.57.69.47A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10Z" fill="currentColor"/>
        </svg>
        GitHub
      </a>
    </div>

    <dl class="mt-10 grid gap-px overflow-hidden rounded-[1.25rem] border border-[var(--line)] bg-[var(--line)] sm:grid-cols-2 lg:grid-cols-4">
      {PROFILE.impactCards.map((card) => (
        <div class="bg-[var(--surface-strong)] p-6">
          <dt class="sr-only">{card.label}</dt>
          <dd class="display text-4xl font-semibold text-[var(--accent)]">{card.value}</dd>
          <dd class="mt-1 text-sm leading-5 text-[var(--muted)]">{card.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="marquee mt-16" aria-hidden="true">
    <div class="marquee-track">
      {[...PROFILE.coreStack, ...PROFILE.coreStack].map((skill) => <span>{skill}</span>)}
    </div>
  </div>

  <section class="mt-20 space-y-8">
    <SectionHeading kicker="Career" title="Work Experience" linkLabel="Full history" linkHref="/about/" />
    <ExperienceList compact />
  </section>

  <section class="mt-20 space-y-8">
    <SectionHeading kicker="Projects" title="Case Studies" linkLabel="View all" linkHref="/projects/" />
    <div class="grid gap-5 md:grid-cols-3">
      {featuredProjects.slice(0, 3).map((project) => (
        <EntryCard
          href={`/projects/${project.slug}/`}
          title={project.data.title}
          description={project.data.description}
          meta={project.data.category}
          tags={project.data.stack.slice(0, 4)}
        />
      ))}
    </div>
  </section>

  <section class="mt-20 space-y-8">
    <SectionHeading kicker="Writing" title="Notes on Spark & Data Delivery" linkLabel="View all" linkHref="/blog/" />
    <div class="grid gap-5 md:grid-cols-2">
      {publishedPosts.slice(0, 2).map((post) => (
        <EntryCard
          href={`/blog/${post.slug}/`}
          title={post.data.title}
          description={post.data.description}
          meta={post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
          tags={post.data.tags.slice(0, 4)}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Types and deletes each role in turn under the name.
  const target = document.querySelector<HTMLElement>("[data-typed]");
  const roles: string[] = JSON.parse(target?.dataset.roles ?? "[]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (target && roles.length > 1 && !reduceMotion) {
    let roleIndex = 0;
    let length = roles[0].length;
    let deleting = true;
    const PAUSE_MS = 1800;

    const tick = () => {
      const role = roles[roleIndex];
      length += deleting ? -1 : 1;
      target.textContent = role.slice(0, length);
      if (deleting && length === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        length = 0;
        setTimeout(tick, 300);
      } else if (!deleting && length === roles[roleIndex].length) {
        deleting = true;
        setTimeout(tick, PAUSE_MS);
      } else {
        setTimeout(tick, deleting ? 35 : 70);
      }
    };

    setTimeout(tick, PAUSE_MS);
  }
</script>
