---
import { NAV_LINKS, SITE } from "@/site";
import { withBase } from "@/lib/withBase";
import ThemeToggle from "@/components/ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[color:var(--nav-bg)]/80 backdrop-blur-xl">
  <div class="container flex items-center justify-between gap-3 py-3 sm:py-4">
    <a href={withBase("/")} class="shrink-0 text-base font-semibold tracking-[0.04em] text-[var(--accent)] sm:text-xl" aria-label="Nikhil Shetty, home">
      <span class="sm:hidden">NS</span>
      <span class="hidden sm:inline">NIKHIL SHETTY</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      <nav aria-label="Primary">
        <ul class="flex items-center gap-0.5 text-sm font-medium text-[var(--muted)] sm:gap-2 sm:text-[1.05rem]">
          {
            NAV_LINKS.map((link) => {
              const href = withBase(link.href);
              const active = currentPath.startsWith(href);
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "rounded-full px-2.5 py-2 transition-colors hover:bg-[var(--surface)] hover:text-[var(--text)] sm:px-3.5 sm:py-2.5",
                      active && "bg-[var(--surface)] text-[var(--text)]",
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
          <li class="hidden sm:block">
            <a
              href={withBase(SITE.resumePath)}
              download
              class="rounded-full px-3.5 py-2.5 text-[var(--accent)] transition-colors hover:bg-[var(--surface)]"
            >
              Resume
            </a>
          </li>
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
