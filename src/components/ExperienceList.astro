---
import { PROFILE } from "@/data/profile";

interface Props {
  // Compact shows the first two bullets per role, for the homepage.
  compact?: boolean;
}

const { compact = false } = Astro.props as Props;
---

<ol class="experience-timeline">
  {PROFILE.experience.map((item) => (
    <li class="experience-item">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 class="text-xl font-semibold tracking-[-0.02em] text-[var(--text)]">
          {item.role} <span class="text-[var(--muted)] font-normal">at</span> {item.company}
        </h3>
        <p class="font-mono text-sm text-[var(--muted)]">{item.period}</p>
      </div>
      <p class="mt-1 text-sm text-[var(--muted)]">{item.context}</p>
      {!compact && <p class="mt-3 text-base leading-7 text-[var(--text)]">{item.summary}</p>}
      <ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-7 text-[var(--muted)] marker:text-[var(--accent)]">
        {(compact ? item.bullets.slice(0, 2) : item.bullets).map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
      <ul class="mt-4 flex flex-wrap gap-2">
        {item.stack.map((tool) => (
          <li class="rounded-full border border-[var(--line)] bg-[var(--surface-strong)] px-3 py-1 text-xs text-[var(--muted)]">
            {tool}
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
