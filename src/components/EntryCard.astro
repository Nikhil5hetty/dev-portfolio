---
import { withBase } from "@/lib/withBase";

interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  tags?: string[];
}

const { href, title, description, meta, tags = [] } = Astro.props as Props;
---

<a
  href={withBase(href)}
  class="group block panel rounded-[1.5rem] p-6 transition duration-200 hover:-translate-y-1 hover:border-[color:var(--accent)]/30 hover:bg-[var(--surface-strong)]"
>
  <div class="flex h-full flex-col gap-4">
    <div class="space-y-2">
      {meta && <p class="kicker">{meta}</p>}
      <h3 class="display text-2xl font-semibold leading-snug text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
        {title}
      </h3>
      <p class="text-base leading-7 text-[var(--muted)]">{description}</p>
    </div>

    {tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="chip">
            {tag}
          </li>
        ))}
      </ul>
    )}
  </div>
</a>
